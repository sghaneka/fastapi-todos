# Production Environment Variables Example
# This shows how to configure for cloud services like AWS, Azure, GCP

# === AWS EXAMPLE ===
# Database - AWS DocumentDB 
MONGO_URI=mongodb://username:password@docdb-cluster.cluster-abc123.us-west-2.docdb.amazonaws.com:27017/?ssl=true&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false
MONGO_DB=fastapi_todos_prod

# Cache - AWS ElastiCache Redis
REDIS_URL=redis://master.redis-cluster.abc123.cache.amazonaws.com:6379

# === AZURE EXAMPLE ===  
# Database - Azure Cosmos DB (MongoDB API)
# MONGO_URI=mongodb://myaccount:key@myaccount.mongo.cosmos.azure.com:10255/?ssl=true&replicaSet=globaldb&maxIdleTimeMS=120000&appName=@myaccount@

# Cache - Azure Cache for Redis
# REDIS_URL=redis://:password@myredis.redis.cache.windows.net:6379

# === GCP EXAMPLE ===
# Database - Google Cloud MongoDB Atlas
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/fastapi_todos?retryWrites=true&w=majority

# Cache - Google Cloud Memorystore Redis
# REDIS_URL=redis://10.0.0.3:6379

# Application Settings
ENVIRONMENT=production
DEBUG=false
MAX_OPEN_TODOS=10